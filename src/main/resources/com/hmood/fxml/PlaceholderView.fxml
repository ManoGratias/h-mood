<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Module prévu mais pas encore implémenté : état explicite, jamais simulé -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hmood.controller.PlaceholderController"
      styleClass="page" spacing="18">
    <HBox spacing="14" alignment="CENTER_LEFT">
        <StackPane fx:id="iconBox" styleClass="placeholder-icon"/>
        <VBox spacing="4">
            <Label fx:id="titleLabel" styleClass="page-title"/>
            <Label fx:id="descriptionLabel" styleClass="page-subtitle" wrapText="true"/>
        </VBox>
    </HBox>
    <VBox styleClass="card" spacing="12" maxWidth="760">
        <Label styleClass="pill, pill-warn" text="Prévu — pas encore disponible dans ce MVP"/>
        <Label styleClass="card-title" text="Ce que ce module apportera"/>
        <VBox fx:id="featuresBox" spacing="8"/>
        <Label fx:id="hintLabel" styleClass="card-text" wrapText="true"/>
    </VBox>
</VBox>
