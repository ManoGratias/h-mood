<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Dashboard : contenu construit par HomeController à partir des données réelles -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hmood.controller.HomeController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox fx:id="content" styleClass="page" spacing="18"/>
</ScrollPane>
